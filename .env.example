# Copiare in .env (escluso da git) e riempire. Mai chiavi con permesso di trading senza ok esplicito.

# Backpack — solo lettura finché non autorizzato
BACKPACK_API_KEY=
BACKPACK_API_SECRET=

# Database del fondo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=growthengenie
POSTGRES_USER=
POSTGRES_PASSWORD=

# Notifiche
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Jev (TypeSafe) — solo dopo la modalità ombra
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=

# Dati macro
FRED_API_KEY=
